# Скрытый системный файл macOS (Desktop Services Store)
.DS_Store

# Исполняемые файлы ОС Windows
*.exe

# Имя исполняемого файла или файла вывода в UNIX-подобных системах
*.out

# Скомпилированный бинарный файл юнит-тестов Go
*.test

# Папка, куда разработчики складывают скомпилированные исполняемые файлы
bin/